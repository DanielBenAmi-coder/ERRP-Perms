APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jerusalem

# Supabase: use the pooled connection string for Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=er-evidence

# Generate long random values and configure them only in Vercel.
AUTH_SECRET=replace_with_a_long_random_secret
MANAGEMENT_PASSWORD_HASH=iterations:saltHex:derivedKeyHex
MANAGEMENT_SESSION_MINUTES=60

MAX_UPLOAD_SIZE_MB=100
MAX_PERMISSION_IMPORT_MB=20
MAX_PERMISSION_IMPORT_ROWS=25000
MAX_PERMISSION_IMPORT_SHEETS=3
PERMISSION_MATCH_WINDOW_MINUTES=10
PERMISSION_REPORT_GRACE_MINUTES=15

# Optional real Discord OAuth (manual login works without these).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
